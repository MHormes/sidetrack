# Production environment — copy this to .env.production on the server and fill in values.
# Never commit .env.production to git.

DATABASE_URL=db_url
POSTGRES_PASSWORD=your_password

# Postcode autofill — free key from https://postcode.tech
POSTCODE_API_KEY=

APP_URL=https://url.com
# Staging URL — used by activate-staging.sh on copied VMs
APP_URL_STAGING=https://staging.example.nl

# Cloudflare Tunnel — required for production HTTPS via example.nl
CLOUDFLARE_TUNNEL_TOKEN=
# Staging tunnel — points to staging.example.nl, offline when not in use
CLOUDFLARE_TUNNEL_TOKEN_STAGING=

# Cloudflare maintenance page toggle — optional, only needed if you have a Worker set up
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=worker_name

# Email provider — "resend" (production), "mailtrap" (staging sandbox), "disabled" (stress testing)
EMAIL_PROVIDER=resend

# Disable Next.js data cache — activate-staging.sh sets this to 1 for stress testing
NEXT_PRIVATE_SKIP_FETCH_CACHE=

# From/notification addresses — used by all providers
FROM_EMAIL=noreply@example.nl
NOTIFICATION_EMAIL=example@example.nl

# Resend — required when EMAIL_PROVIDER=resend
# Verify example.nl in the Resend dashboard to unlock custom from address
RESEND_API_KEY=

# Mailtrap — only needed if EMAIL_PROVIDER=mailtrap (dev/local testing)
# Never required in production
# Credentials from https://mailtrap.io → Email Testing → SMTP Settings
MAILTRAP_USER=
MAILTRAP_PASS=